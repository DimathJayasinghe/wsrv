*.gcno
*.profraw
*.profdata

# Fuzzing / sanitizer / profiling artefacts
crash-*
leak-*
timeout-*
oom-*
*.log
perf.data*
core
core.*
vgcore.*

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

