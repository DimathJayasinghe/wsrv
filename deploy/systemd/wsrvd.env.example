# /etc/wsrv/wsrvd.env: one WSRVD_<KEY>=value per line (docs/OPERATIONS.md has every key). No quotes needed.
# Tokens are never environment variables: put each in a file, mode 0600, owned by wsrv, and name the file.

# Where browsers come from. A list: WSRVD_ALLOW_ORIGIN=https://a.example,https://b.example
WSRVD_ALLOW_ORIGIN=https://app.example.com

# Behind nginx/Caddy on the same host: listen on loopback only, and say who the proxy is so that the
# per-IP limits count real clients (ADR-0029).
WSRVD_LISTEN_HOST=127.0.0.1
WSRVD_LISTEN_PORT=8080
WSRVD_TRUSTED_PROXY=127.0.0.1,::1

WSRVD_MAX_CONNECTIONS=10000
# The bytes all connections may hold in partial messages and unwritten output before new clients get a 503
# (ADR-0040). Default 1 GiB; with MemoryMax set in the unit, use about half of it.
# WSRVD_MAX_BUFFERED_BYTES=268435456
WSRVD_THREADS=2

# Metrics and health, plain HTTP, no authentication: loopback only (Prometheus scrapes it locally).
WSRVD_ADMIN_PORT=9101
# To let a Prometheus on another machine scrape it, bind WSRVD_ADMIN_HOST to a private address and require a token
# for /metrics (ADR-0041; /healthz and /readyz stay open). The token must be one wsrvd made, and a different one
# from the publish and IPC tokens:
#   sudo -u wsrv /usr/local/bin/wsrvd --generate-token=/etc/wsrv/admin.token
# WSRVD_ADMIN_TOKEN_FILE=/etc/wsrv/admin.token

# Rooms and HTTP publishing (ADR-0028). From wsrv 1.1 the token must be one wsrvd made (ADR-0039), mode 0600;
# the generator creates the file itself and never overwrites one:
#   sudo -u wsrv /usr/local/bin/wsrvd --generate-token=/etc/wsrv/publish.token
# WSRVD_BROKER=true
# WSRVD_PUBLISH_PORT=9200
# WSRVD_PUBLISH_TOKEN_FILE=/etc/wsrv/publish.token

# TLS directly on wsrvd (or terminate it at the proxy and leave this out):
# WSRVD_TLS_CERT=/etc/wsrv/cert.pem
# WSRVD_TLS_KEY=/etc/wsrv/key.pem
