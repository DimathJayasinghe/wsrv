# wsrvd under systemd (docs/DEPLOYMENT.md). Install:
#   useradd --system --no-create-home --shell /usr/sbin/nologin wsrv
#   install -m 0755 wsrvd /usr/local/bin/wsrvd
#   install -d -m 0750 -o root -g wsrv /etc/wsrv
#   install -m 0640 -o root -g wsrv wsrvd.env.example /etc/wsrv/wsrvd.env     # then edit it
#   install -m 0644 wsrvd.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now wsrvd
# The PHP worker must run as the same user: the IPC socket is mode 0600 and the daemon checks the peer uid.
[Unit]
Description=wsrvd WebSocket sidecar (RFC 6455)
Documentation=https://github.com/DimathJayasinghe/wsrv/blob/main/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wsrv
Group=wsrv
# /run/wsrv, mode 0700, owned by wsrv: the daemon refuses a socket directory that others can write.
RuntimeDirectory=wsrv
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
Environment=WSRVD_IPC_SOCKET=/run/wsrv/ipc.sock
# Settings (WSRVD_<KEY>=value), see wsrvd.env.example. A leading '-' = the file may be absent.
EnvironmentFile=-/etc/wsrv/wsrvd.env
ExecStart=/usr/local/bin/wsrvd
# SIGHUP re-reads the TLS certificate (ADR-0019) without dropping connections.
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM = graceful: Close 1001 to every client, then exit within shutdown_grace (10 s by default).
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

# One descriptor per connection plus a few: size this above max_connections (docs/OPERATIONS.md section 4).
LimitNOFILE=1048576
# MemoryMax=2G      # uncomment and size from max_connections x memory per connection

# Hardening (docs/OPERATIONS.md section 5). wsrvd needs only its sockets and, for TLS, to read its key.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# To listen on a port below 1024 without root: AmbientCapabilities=CAP_NET_BIND_SERVICE and
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE. Behind a reverse proxy you do not need it.

[Install]
WantedBy=multi-user.target
