{
  "name": "wsrv-client",
  "version": "0.0.0",
  "description": "A WebSocket client that survives restarts: exponential backoff with jitter, a fresh ticket per attempt, rooms re-joined after every reconnect. Browser and Node 22+, no dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/client.js",
  "types": "./src/client.d.ts",
  "exports": {
    ".": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    }
  },
  "files": ["src", "README.md"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/DimathJayasinghe/wsrv.git", "directory": "clients/js" },
  "scripts": {
    "test": "node --test test/client.test.js test/platform.test.js test/interop.test.js"
  },
  "private": true
}
